    "Recent sleep duration with its source and wake time. Local estimates may be incomplete.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recent sleep duration with its source and wake time. Local estimates may be incomplete."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dauer des letzten Schlafs mit Quelle und Aufwachzeit. Lokale Schätzungen können unvollständig sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Duración del sueño reciente con su fuente y hora de despertar. Las estimaciones locales pueden estar incompletas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durée du sommeil récent avec sa source et l’heure du réveil. Les estimations locales peuvent être incomplètes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durata del sonno recente con fonte e ora del risveglio. Le stime locali possono essere incomplete."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czas ostatniego snu ze źródłem i godziną pobudki. Lokalne szacunki mogą być niepełne."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Duração do sono recente com a respetiva origem e hora de despertar. As estimativas locais podem estar incompletas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжительность недавнего сна с источником и временем пробуждения. Локальные оценки могут быть неполными."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
