    "Enable Morning Brief in Coach settings to see today's readiness here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Morning Brief in Coach settings to see today's readiness here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere den Morgenbrief in den Coach-Einstellungen, um die heutige Bereitschaft hier zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el resumen matutino en los ajustes de Coach para ver la disponibilidad de hoy aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez le bref du matin dans les réglages du Coach pour voir la disponibilité du jour ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva il riepilogo mattutino nelle impostazioni di Coach per vedere la disponibilità di oggi qui."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz poranne podsumowanie w ustawieniach Coach, aby zobaczyć tu dzisiejszą gotowość."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
