    "Today's band-motion estimate and chosen goal. Estimates are labelled; refresh timing is controlled by iOS.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's band-motion estimate and chosen goal. Estimates are labelled; refresh timing is controlled by iOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die heutige Schätzung aus Bandbewegung und das gewählte Ziel. Schätzungen sind gekennzeichnet; iOS bestimmt den Aktualisierungszeitpunkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimación de hoy a partir del movimiento de la pulsera y objetivo elegido. Las estimaciones se identifican; iOS controla cuándo se actualizan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimation du jour d’après les mouvements du bracelet et objectif choisi. Les estimations sont signalées ; iOS contrôle les mises à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stima odierna dal movimento del bracciale e obiettivo scelto. Le stime sono indicate; iOS controlla i tempi di aggiornamento."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzisiejszy szacunek na podstawie ruchu opaski i wybrany cel. Szacunki są oznaczone; iOS określa czas odświeżania."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimativa de hoje a partir do movimento da pulseira e objetivo escolhido. As estimativas estão identificadas; o iOS controla quando são atualizadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодняшняя оценка по движению браслета и выбранная цель. Оценки помечены; время обновления определяет iOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据手环运动估算的今日步数及所选目标。估算值会明确标注；刷新时间由 iOS 控制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據手環動作估算的今日步數及所選目標。估算值會明確標示；更新時間由 iOS 控制。"
          }
        }
      }
    },
    "Used by the personal steps widget. WHOOP 4.0 steps are estimates from motion; a goal does not make them measured steps.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used by the personal steps widget. WHOOP 4.0 steps are estimates from motion; a goal does not make them measured steps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird vom persönlichen Schritte-Widget verwendet. Die Schritte der WHOOP 4.0 werden aus Bewegung geschätzt; ein Ziel macht daraus keine gemessenen Schritte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa en el widget personal de pasos. Los pasos de WHOOP 4.0 se estiman a partir del movimiento; fijar un objetivo no los convierte en pasos medidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé par le widget personnel de pas. Les pas de la WHOOP 4.0 sont estimés à partir des mouvements ; un objectif ne les transforme pas en pas mesurés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usato dal widget personale dei passi. I passi di WHOOP 4.0 sono stimati dal movimento; un obiettivo non li rende passi misurati."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używany przez osobisty widżet kroków. Kroki WHOOP 4.0 są szacowane na podstawie ruchu; ustawienie celu nie zmienia ich w zmierzone kroki."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizado pelo widget pessoal de passos. Os passos da WHOOP 4.0 são estimados a partir do movimento; definir um objetivo não os torna passos medidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется в личном виджете шагов. Шаги WHOOP 4.0 оцениваются по движению; установка цели не превращает их в измеренные шаги."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于个人步数小组件。WHOOP 4.0 的步数根据运动估算；设置目标并不会使其变成实测步数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於個人步數小工具。WHOOP 4.0 的步數根據動作估算；設定目標並不會使其變成實測步數。"
          }
        }
      }
    },
